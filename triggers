-- PROCEDURE 1: Submit a Research Paper
DELIMITER $$

CREATE PROCEDURE submit_paper(
    IN sid   INT,
    IN sdate DATE,
    IN stat  VARCHAR(30),
    IN pid   INT,
    IN cid   INT
)
BEGIN
    INSERT INTO Submission
    VALUES (sid, sdate, stat, pid, cid);
    SELECT CONCAT('Paper ', pid, ' successfully submitted to Conference ', cid) AS message;
END$$

DELIMITER ;

-- Call Procedure 1
CALL submit_paper(620, '2025-05-01', 'Submitted', 204, 502);


