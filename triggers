-- PROCEDURE 2: Withdraw a Submission
DELIMITER $$

CREATE PROCEDURE withdraw_submission(
    IN sid INT
)
BEGIN
    DELETE FROM Submission
    WHERE submission_id = sid;
    SELECT CONCAT('Submission ', sid, ' has been withdrawn') AS message;
END$$

DELIMITER ;

-- Call Procedure 2
CALL withdraw_submission(620);


