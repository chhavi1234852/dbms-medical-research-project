-- FUNCTION 1: Get Total Citation Count for a Paper
-- Returns how many times a paper has been cited

DELIMITER $$

CREATE FUNCTION get_citation_count(pid INT)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE total INT;
    SELECT COUNT(*) INTO total
    FROM Citation
    WHERE cited_paper_id = pid;
    RETURN total;
END$$

DELIMITER ;

-- Call Function 1
SELECT get_citation_count(201) AS citation_count_for_paper_201;
SELECT get_citation_count(202) AS citation_count_for_paper_202;


