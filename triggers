-- PROCEDURE 3: Get All Papers by an Author
DELIMITER $$

CREATE PROCEDURE get_papers_by_author(
    IN aid INT
)
BEGIN
    SELECT rp.paper_id,
           rp.title,
           rp.publication_year,
           rd.domain_name
    FROM Author_Paper ap
    JOIN Research_Paper  rp ON rp.paper_id  = ap.paper_id
    JOIN Research_Domain rd ON rd.domain_id = rp.domain_id
    WHERE ap.author_id = aid;
END$$

DELIMITER ;

-- Call Procedure 3 for author 1
CALL get_papers_by_author(1);


