-- FUNCTION 3: Check if Author is Registered for a Conference
-- Returns 1 if registered, 0 if not

DELIMITER $$

CREATE FUNCTION is_author_registered(aid INT, cid INT)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE result INT;
    SELECT COUNT(*) INTO result
    FROM Registration
    WHERE author_id = aid
    AND   conf_id   = cid;
    IF result > 0 THEN
        RETURN 1;
    ELSE
        RETURN 0;
    END IF;
END$$

DELIMITER ;

-- Call Function 3
SELECT is_author_registered(1, 501) AS is_registered;  -- should return 1
SELECT is_author_registered(4, 501) AS is_registered;  -- should return 0


