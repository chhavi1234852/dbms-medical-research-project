-- PROCEDURE 4: Get Review Summary for a Paper
DELIMITER $$

CREATE PROCEDURE get_review_summary(
    IN pid INT
)
BEGIN
    SELECT rv.name      AS reviewer_name,
           r.rating,
           r.comments,
           rp.title     AS paper_title
    FROM Review r
    JOIN Reviewer       rv ON rv.reviewer_id = r.reviewer_id
    JOIN Research_Paper rp ON rp.paper_id    = r.paper_id
    WHERE r.paper_id = pid;
END$$

DELIMITER ;

-- Call Procedure 4 for paper 201
CALL get_review_summary(201);


