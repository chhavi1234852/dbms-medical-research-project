-- CURSOR 2: Loop through all Submissions and show status summary
-- Counts accepted vs under review using a cursor

DELIMITER $$

CREATE PROCEDURE submission_status_summary()
BEGIN
    DECLARE done         INT DEFAULT 0;
    DECLARE v_status     VARCHAR(50);
    DECLARE v_paper_id   INT;
    DECLARE v_conf_id    INT;
    DECLARE accepted_count   INT DEFAULT 0;
    DECLARE review_count     INT DEFAULT 0;

    -- Declare cursor
    DECLARE sub_cursor CURSOR FOR
        SELECT status, paper_id, conf_id
        FROM Submission;

    -- Handler
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    OPEN sub_cursor;

    status_loop: LOOP
        FETCH sub_cursor INTO v_status, v_paper_id, v_conf_id;
        IF done = 1 THEN
            LEAVE status_loop;
        END IF;

        IF v_status = 'Accepted' THEN
            SET accepted_count = accepted_count + 1;
        ELSEIF v_status = 'Under Review' THEN
            SET review_count = review_count + 1;
        END IF;
    END LOOP;

    CLOSE sub_cursor;

    -- Show final counts
    SELECT accepted_count AS total_accepted,
           review_count   AS total_under_review;
END$$

DELIMITER ;

-- Call Cursor 2
CALL submission_status_summary();


