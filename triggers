-- TRIGGER 3: Prevent Self-Citation
-- A paper cannot cite itself

DELIMITER $$

CREATE TRIGGER prevent_self_citation
BEFORE INSERT ON Citation
FOR EACH ROW
BEGIN
    IF NEW.citing_paper_id = NEW.cited_paper_id THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'A paper cannot cite itself';
    END IF;
END$$

DELIMITER ;

-- Test Trigger 3: Self citation (should FAIL)
