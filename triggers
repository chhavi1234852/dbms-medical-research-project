-- TRIGGER 2: Auto-set Submission Status to 'Under Review'
-- If no status provided, default to 'Under Review'

DELIMITER $$

CREATE TRIGGER set_default_status
BEFORE INSERT ON Submission
FOR EACH ROW
BEGIN
    IF NEW.status IS NULL OR NEW.status = '' THEN
        SET NEW.status = 'Under Review';
    END IF;
END$$

DELIMITER ;


