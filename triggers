-- PROCEDURE 5: Register Author for Conference
DELIMITER $$

CREATE PROCEDURE register_author(
    IN rid   INT,
    IN rdate DATE,
    IN aid   INT,
    IN cid   INT
)
BEGIN
    INSERT INTO Registration VALUES (rid, rdate, aid, cid);
    SELECT CONCAT('Author ', aid, ' registered for Conference ', cid) AS message;
END$$

