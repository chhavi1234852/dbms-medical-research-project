-- CURSOR 3: Loop through all Authors and show their paper count

DELIMITER $$

CREATE PROCEDURE author_paper_count()
BEGIN
    DECLARE done        INT DEFAULT 0;
    DECLARE v_author_id INT;
    DECLARE v_name      VARCHAR(100);
    DECLARE v_count     INT;

    -- Declare cursor
    DECLARE author_cursor CURSOR FOR
        SELECT a.author_id, a.name
        FROM Author a;

    -- Handler
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    OPEN author_cursor;

    author_loop: LOOP
        FETCH author_cursor INTO v_author_id, v_name;
        IF done = 1 THEN
            LEAVE author_loop;
        END IF;

        -- Count papers for this author
        SELECT COUNT(*) INTO v_count
        FROM Author_Paper
        WHERE author_id = v_author_id;

        -- Display result
        SELECT v_author_id AS author_id,
               v_name      AS author_name,
               v_count     AS total_papers;
    END LOOP;

    CLOSE author_cursor;
END$$

DELIMITER ;

-- Call Cursor 3
CALL author_paper_count();


