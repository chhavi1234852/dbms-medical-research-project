-- TRIGGER 1: Prevent Duplicate Submission
-- Stops same paper being submitted to same conference twice

DELIMITER $$

CREATE TRIGGER prevent_duplicate_submission
BEFORE INSERT ON Submission
FOR EACH ROW
BEGIN
    IF EXISTS (
        SELECT 1
        FROM Submission
        WHERE paper_id = NEW.paper_id
        AND   conf_id  = NEW.conf_id
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Duplicate submission not allowed for same conference';
    END IF;
END$$

DELIMITER ;

-- Test Trigger 1: First insert (should succeed)
INSERT INTO Submission VALUES (310, '2025-03-01', 'Submitted', 201, 501);

-- Test Trigger 1: Second insert same paper + conference (should FAIL)
INSERT INTO Submission VALUES (311, '2025-03-02', 'Submitted', 201, 501);


