-- FUNCTION 2: Get Average Rating for a Paper
-- Returns average review rating for a given paper

DELIMITER $$

CREATE FUNCTION get_avg_rating(pid INT)
RETURNS DECIMAL(4,2)
DETERMINISTIC
BEGIN
    DECLARE avg_rating DECIMAL(4,2);
    SELECT AVG(rating) INTO avg_rating
    FROM Review
    WHERE paper_id = pid;
    RETURN avg_rating;
END$$

DELIMITER ;

-- Call Function 2
SELECT get_avg_rating(201) AS avg_rating_paper_201;
SELECT get_avg_rating(202) AS avg_rating_paper_202;


