-- CURSOR 1: Loop through all Research Papers and print details
-- Shows how cursors iterate row by row

DELIMITER $$

CREATE PROCEDURE print_all_papers()
BEGIN
    DECLARE done       INT DEFAULT 0;
    DECLARE v_id       INT;
    DECLARE v_title    VARCHAR(200);
    DECLARE v_year     INT;
    DECLARE v_domain   INT;

    -- Declare the cursor
    DECLARE paper_cursor CURSOR FOR
        SELECT paper_id, title, publication_year, domain_id
        FROM Research_Paper;

    -- Handler for when no more rows
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    -- Open cursor
    OPEN paper_cursor;

    -- Loop through each row
    read_loop: LOOP
        FETCH paper_cursor INTO v_id, v_title, v_year, v_domain;
        IF done = 1 THEN
            LEAVE read_loop;
        END IF;
        -- Print each paper
        SELECT v_id AS paper_id, v_title AS title, v_year AS year, v_domain AS domain_id;
    END LOOP;

    -- Close cursor
    CLOSE paper_cursor;
END$$

DELIMITER ;

-- Call Cursor 1
CALL print_all_papers();


